4. SUPABASE DB SCHEMA (5 TABLES – DO NOT MODIFY)
============================================================

CREATE TABLE public.users (
    id uuid REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,
    email text NOT NULL UNIQUE,
    subscription_plan text DEFAULT 'free' NOT NULL,
    billing_cycle text DEFAULT 'monthly',
    credits integer DEFAULT 5 NOT NULL,
    next_billing_date date,
    customer_id text,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.tools (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    name text NOT NULL,
    affiliate_url text NOT NULL,
    desc_en text,
    desc_ko text,
    desc_simple_en text,
    desc_senior text,
    manual_rank integer DEFAULT 999 NOT NULL,
    task_category text NOT NULL,
    best_for text,
    rank_in_task integer DEFAULT 999 NOT NULL,
    why_pick text,
    tags text[],
    related_gear text,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.saved_tools (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    user_id uuid REFERENCES public.users(id) ON DELETE CASCADE NOT NULL,
    tool_id uuid REFERENCES public.tools(id) ON DELETE CASCADE NOT NULL,
    folder_name text,
    memo text,
    created_at timestamptz DEFAULT now(),
    UNIQUE (user_id, tool_id)
);

CREATE TABLE public.credit_logs (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    user_id uuid REFERENCES public.users(id) ON DELETE CASCADE NOT NULL,
    action_type text NOT NULL,
    feature_name text NOT NULL,
    amount integer NOT NULL,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.prompts (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    tool_id uuid REFERENCES public.tools(id) ON DELETE CASCADE NOT NULL,
    title text NOT NULL,
    content text NOT NULL,
    is_premium boolean DEFAULT FALSE NOT NULL,
    created_at timestamptz DEFAULT now()
);


